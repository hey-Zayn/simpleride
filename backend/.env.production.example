# Copy the relevant values into each service's local .env for development.
# Production: inject secret values from AWS Secrets Manager; do not copy secrets into this file.

# Shared secrets (Secrets Manager)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
RABBITMQ_URL=amqps://user:password@host/vhost
REDIS_URL=rediss://default:password@host:port
CORS_ORIGIN=https://app.example.com,https://app.staging.example.com
SHUTDOWN_TIMEOUT_MS=55000
RABBITMQ_PREFETCH=10

# Gateway
PORT=5000
AUTH_SERVICE_URL=http://auth-service:4001
LOCATION_SERVICE_URL=http://location-service:4002
NOTIFICATION_SERVICE_URL=http://notification-service:4003
RIDE_SERVICE_URL=http://ride-service:4004
LOCATION_SOCKET_PREFIX=/location

# Auth / database-backed services
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Location
GRPC_PORT=50051
LOCATION_SOCKET_PATH=/socket.io

# Ride
LOCATION_SERVICE_GRPC_URL=location-service:50051
BULLMQ_CONCURRENCY=10

# Notification email
EMAIL_USER=verified-sender@example.com
EMAIL_PASS=provider-api-key-or-smtp-password