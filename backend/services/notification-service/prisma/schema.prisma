datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationType {
  PUSH
  EMAIL
  SMS
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType @default(PUSH)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}
